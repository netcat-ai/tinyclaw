ARG GO_IMAGE=golang:1.26-bookworm

FROM ${GO_IMAGE} AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/msghub ./cmd/msghub
COPY internal ./internal
RUN CGO_ENABLED=0 go build -o /out/msghub ./cmd/msghub

FROM debian:bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /out/msghub /app/msghub
ENTRYPOINT ["/app/msghub"]
